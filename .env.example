# Kopiere diese Datei nach .env und fuelle die Werte aus dem Supabase-Dashboard
# (Project Settings -> API). .env ist in .gitignore.

# Oeffentlich: Projekt-URL und anon key landen im Client-Bundle. Das ist so vorgesehen,
# ihr Schutz ist Row Level Security, nicht Geheimhaltung.
PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
PUBLIC_SUPABASE_ANON_KEY=""

# Geheim: umgeht RLS. Nur in serverseitigem Code ($env/dynamic/private) verwenden,
# nie in +page.svelte oder src/lib ohne server/-Pfad.
SUPABASE_SERVICE_ROLE_KEY=""

# Ab Phase 3, ebenfalls ausschliesslich serverseitig (harte Regel 6).
ANTHROPIC_API_KEY=""
